{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fenrir:wallpaper-pack:v1",
  "title": "Fenrir rights-cleared wallpaper pack",
  "type": "object",
  "required": ["schema", "version", "criteria", "allowed_hosts", "items"],
  "properties": {
    "schema": {"const": "org.fenrir.wallpaper-pack"},
    "version": {"const": 1},
    "criteria": {
      "type": "object",
      "required": ["minimum_width", "minimum_height", "preferred_width", "preferred_height", "orientation", "preferred_palette"],
      "properties": {
        "minimum_width": {"type": "integer", "minimum": 2560},
        "minimum_height": {"type": "integer", "minimum": 1440},
        "preferred_width": {"type": "integer", "minimum": 3840},
        "preferred_height": {"type": "integer", "minimum": 2160},
        "orientation": {"const": "landscape"},
        "preferred_palette": {"const": ["obsidian", "arctic-blue", "violet", "emerald", "deep-green", "dramatic-red"]}
      }
    },
    "minimum_transfer_interval_seconds": {"type": "number", "minimum": 0.25, "maximum": 60, "default": 1.0},
    "allowed_hosts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "items": {
      "type": "array",
      "minItems": 5000,
      "items": {
        "type": "object",
        "required": ["id", "filename", "url", "sha256", "width", "height", "creator", "source_url", "license", "license_url", "provider_terms_url", "rights_decision", "rights_decision_id", "acquisition_authorization_id", "acceptance_decision_id", "duplicate_review_id", "provider_terms_evidence_id", "automated_download_permitted", "acquisition_authorized", "human_accepted", "duplicate_cleared", "personal_use_permitted", "tags"],
        "properties": {
          "id": {"type": "string"}, "filename": {"type": "string"},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "width": {"type": "integer", "minimum": 2560}, "height": {"type": "integer", "minimum": 1440},
          "creator": {"type": "string", "minLength": 1}, "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "license": {"enum": ["CC0-1.0", "CC-BY-3.0", "CC-BY-4.0", "CC-BY-SA-3.0", "CC-BY-SA-4.0"]},
          "license_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "provider_terms_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "rights_decision": {"const": "human_approved"},
          "rights_decision_id": {"type": "string", "minLength": 1},
          "acquisition_authorization_id": {"type": "string", "minLength": 1},
          "acceptance_decision_id": {"type": "string", "minLength": 1},
          "duplicate_review_id": {"type": "string", "minLength": 1},
          "provider_terms_evidence_id": {"type": "string", "minLength": 1},
          "automated_download_permitted": {"const": true}, "acquisition_authorized": {"const": true},
          "human_accepted": {"const": true}, "duplicate_cleared": {"const": true}, "personal_use_permitted": {"const": true},
          "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
